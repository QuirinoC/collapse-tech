{
  "name": "collapse-tech",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:challenge": "npm --prefix apps/asymmetric-challenge run dev",
    "dev:studio": "npm --prefix apps/collapse-technologies run dev",
    "build": "npm run build:challenge && npm run build:studio",
    "build:challenge": "npm --prefix apps/asymmetric-challenge run build",
    "build:studio": "npm --prefix apps/collapse-technologies run build",
    "lint": "npm run lint:challenge && npm run lint:studio",
    "lint:challenge": "npm --prefix apps/asymmetric-challenge run lint",
    "lint:studio": "npm --prefix apps/collapse-technologies run lint",
    "test": "npm --prefix apps/asymmetric-challenge run test"
  }
}
