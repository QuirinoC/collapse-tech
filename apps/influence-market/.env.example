# --- Data layer (Supabase Postgres) ---
# When both are set the app persists to Supabase. When absent it falls back to
# an in-memory seeded store so the whole escrow loop can run locally/demo.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments ---
# When STRIPE_SECRET_KEY is set, charges go through Stripe PaymentIntents and
# payouts through Stripe Transfers. When absent, the sandbox provider mirrors
# the exact same state transitions with fake references.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
