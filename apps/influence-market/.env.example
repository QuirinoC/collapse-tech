# --- Data layer ---
# Option A (production on Cloudflare Workers): Cloudflare D1 via the native
# `DB` binding declared in wrangler.jsonc. Set SUPABASE_QUERY_ENDPOINT to any
# non-empty value as a deploy-time flag that persistence is enabled; the
# binding itself is resolved at runtime through @opennextjs/cloudflare.
SUPABASE_QUERY_ENDPOINT=
# Option B: Supabase Postgres. When both of these are set the app persists to
# Supabase via supabase-js.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# When none of the above are set the app falls back to an in-memory seeded
# store so the whole escrow loop can run locally/demo.

# --- Payments ---
# Payment funding is disabled in production until a processor-backed checkout,
# verified webhooks, and creator destination accounts are implemented.
# PAYMENTS_MODE=sandbox may be used only outside production for local tests.
PAYMENTS_MODE=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
