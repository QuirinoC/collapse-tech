# Required for live Jev (BALATRO_JEV_MODE=live or auto when key is set).
# Never commit the real key — copy to .env locally.
TYPESAFE_API_KEY=

# Pinned System One model. Aliases move; do not use jev-latest for holdouts.
JEV_MODEL_ID=jev-1.13.0

# mock | live — auto: live when TYPESAFE_API_KEY is set, else mock
BALATRO_JEV_MODE=

# Directory for state.json ↔ action.json IPC with the Lua mod (default: ./ipc).
# macOS Steam Balatro Love2D save (mod writes balatro_jev/ here):
BALATRO_JEV_IPC_DIR=/Users/REPLACE_ME/Library/Application Support/Balatro/balatro_jev

# Choice confidence floor; below this the bridge falls back to a safe action.
MIN_ACTION_CONFIDENCE=0.45

# Request timeout for System One (ms)
JEV_TIMEOUT_MS=30000
