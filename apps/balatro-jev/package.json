{
  "name": "balatro-jev",
  "version": "0.1.0",
  "private": true,
  "description": "Balatro state → Jev Choice → action bridge (TypeSafe System One, no vision)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/index.ts --once --fixture fixtures/hand-state.json",
    "mock": "BALATRO_JEV_MODE=mock tsx --env-file-if-exists=.env src/index.ts --once --fixture fixtures/hand-state.json",
    "watch": "tsx --env-file-if-exists=.env src/index.ts --watch",
    "launch:macos": "bash scripts/macos-launch-lovely.sh",
    "simulate": "BALATRO_JEV_MODE=${BALATRO_JEV_MODE:-mock} tsx --env-file-if-exists=.env scripts/simulate.ts",
    "smoke:live": "tsx --env-file-if-exists=.env scripts/smoke-jev-live.mts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
