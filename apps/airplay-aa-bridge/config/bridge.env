# AirPlay → wired Android Auto bridge configuration
# Copied to /etc/airplay-aa/bridge.env on install.

# Receiver name shown in AirPlay picker on iPhone / Mac
AIRPLAY_AA_NAME="Pi AirPlay AA"

# Install prefix (binaries + AAServer)
AIRPLAY_AA_PREFIX=/opt/airplay-aa

# Runtime paths
AIRPLAY_AA_SOCKET=/var/run/airplay-aa/aaserver.sock
AIRPLAY_AA_H264=/var/run/airplay-aa/video.h264
AIRPLAY_AA_IDLE_AU=/var/run/airplay-aa/idle.h264
AIRPLAY_AA_LOGDIR=/var/log/airplay-aa

# Android Auto video surface (common HU negotiation)
AIRPLAY_AA_WIDTH=800
AIRPLAY_AA_HEIGHT=480
AIRPLAY_AA_FPS=30
AIRPLAY_AA_IDLE_TIMEOUT=1.0

# Bench test: set to test-pattern to send moving SMPTE bars through the
# real encoder → injector → AAServer → USB path. Default is AirPlay.
# AIRPLAY_AA_SOURCE=airplay

# Optional AAServer PCAP dump (empty to disable)
AIRPLAY_AA_DUMP=

# Wireless Android Auto is NOT used. USB gadget / AOAP only.
AIRPLAY_AA_WIRELESS=0
