[Unit]
Description=AirPlay receiver → wired Android Auto (USB) bridge
# USB/AOA must be available even when no saved Wi-Fi network is in range.
# The receiver is a server; its supervisor retries if networking is not ready.
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/airplay-aa/bridge.env
WorkingDirectory=/opt/airplay-aa
ExecStart=/opt/airplay-aa/scripts/run-bridge.sh
# Recover even if a child exits cleanly so AOAP wait stays alive for the car.
Restart=always
RestartSec=3
# Needs USB gadget + /sys/kernel/config
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_ADMIN CAP_SYS_NICE
AmbientCapabilities=CAP_SYS_ADMIN CAP_NET_ADMIN
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
