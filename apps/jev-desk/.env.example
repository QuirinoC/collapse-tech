# Required for MODEL=jev (or COMPARE=1 with a live Jev book). Never commit the real key.
TYPESAFE_API_KEY=

# mock | jev   — who answers regime/quote_ok/toxic/lean (+ naive control)
MODEL=mock

# mm (maker desk) | range (paper fade clip; separate path)
MODE=mm
# Range ACT is expensive. Choice confidence floor for nothing_burger (default 0.85).
# RANGE_ACT_MIN_CONFIDENCE=0.85

# When 1 and a key is set, also score the other model as an extra composer.
COMPARE=1

# live | mock | replay (fixtures/ugly-day.json) | kuru (fixtures/kuru-mon-usdc-2026-09-16.json)
TAPE=live
# Optional override for TAPE=kuru
# REPLAY_FIXTURE=

# How many new heads to process. HOURS overrides BLOCKS when set.
BLOCKS=200
# Hours-long holdout: HOURS=2 ≈ 24,000 heads at 300ms.
# HOURS=2

# Call the composer every N heads. Still read every head for prints / markout.
DECISION_EVERY_BLOCKS=27

# Markout horizon in chain blocks. ~100 ≈ 30s.
HORIZON_BLOCKS=100

# Pinned System One model. Aliases move; do not use jev-latest for a holdout.
JEV_MODEL_ID=jev-1.13.0

# --- confidence / probability gates (explicit; not log-only) ---
# Old bug: MIN_CONFIDENCE=0 — we forced a trade every slot and only logged confidence.
# Choice/Score confidence floors (TypeSafe confidence-routing): skip/pull is cheap,
# so a moderate regime floor is enough. Leaning ticks/size is expensive — higher floor.
REGIME_MIN_CONFIDENCE=0.6
LEAN_MIN_CONFIDENCE=0.85

# Noul has no separate confidence. These are yes-probabilities.
QUOTE_OK_MIN=0.65
QUOTE_OK_UNCERTAIN_BAND=0.15
TOXIC_PULL=0.55

# Calibration headline slice (report accuracy only here).
HIGH_CONF_SLICE=0.85

RPC_URL=https://rpc.monad.xyz
MARKET=0x065C9d28E428A0db40191a54d33d5b7c71a9C394
TRADE_SIZE_MON=200
MAX_POSITION_MON=1000
QUOTE_INSIDE_TICKS=1
INVENTORY_SKEW_TICKS=2
GAS_USD_PER_REPLACE=0.02
GAS_USD_SOURCE=assumed-unknown-high
REPLACE_MIN_MS=8000
REPLACE_MID_TICKS=2
PROP_MAINTAIN_BPS=2000
INCLUSION_DELAY_BLOCKS=2
BANKROLL_USD=100
DAILY_LOSS_USD=25
DEAD_MAN_MS=5000
# Live JS ABI cannot read SOFT_PAUSED. TAPE=live fail-closes on UNKNOWN. No PRIVATE_KEY.
# Optional text for speculative material_headline (ignored if empty).
# HEADLINE=
