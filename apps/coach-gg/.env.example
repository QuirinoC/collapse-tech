# start.gg API key (get from start.gg developer settings)
STARTGG_APIKEY=your_api_key_here

# Redis connection string
# Local dev: localhost:6379
# Upstash: fast-rodent-87351.upstash.io:6379,password=YOUR_PASSWORD,ssl=True
REDIS_CONNECTION=localhost:6379

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080
