{
  "Redis": {
    "InstanceName": "PixelBoard_"
  },
  "Firebase": {
    "Enabled": false
  },
  "Postgres": {
    "Enabled": false
  },
  "PlacementOutbox": {
    "BatchSize": 100,
    "ClaimIdleMilliseconds": 30000,
    "EmptyPollMilliseconds": 1000
  },
  "StoreKit": {
    "Enabled": false,
    "AllowedEnvironments": [
      "Production"
    ]
  },
  "Advertising": {
    "WebEnabled": false,
    "MobileEnabled": false
  },
  "Security": {
    "AbuseSignalHashingEnabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
