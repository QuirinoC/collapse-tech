@page "/moderation"
@{
    Layout = null;
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Pixelboard moderation</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/moderation.css" asp-append-version="true" />
</head>
<body>
    <header class="console-header">
        <div>
            <p class="eyebrow">Collapse Technologies / Private operations</p>
            <h1>Pixelboard moderation</h1>
        </div>
        <div class="console-actions">
            <button id="moderator-sign-in" type="button">Sign in with Google</button>
            <button id="moderator-sign-out" type="button" hidden>Sign out</button>
            <button id="refresh" type="button">Refresh queue</button>
        </div>
    </header>

    <div class="status-shell">
        <p id="status" class="status" role="status">Connecting to moderator services...</p>
    </div>

    <main id="moderator-console" hidden>
        <section class="safety-panel" aria-labelledby="safety-heading">
            <div>
                <p class="eyebrow">Emergency controls</p>
                <h2 id="safety-heading">Platform safety state</h2>
            </div>
            <label><input id="placements-frozen" type="checkbox" /> Freeze placements</label>
            <label><input id="ads-disabled" type="checkbox" /> Disable advertising</label>
            <label>
                Reason
                <input id="safety-reason" type="text" maxlength="500"
                       value="Moderator safety control update" />
            </label>
            <button id="save-safety" type="button">Apply safety state</button>
        </section>

        <section class="broadcast-panel" aria-labelledby="broadcast-heading">
            <div class="section-heading">
                <p class="eyebrow">Targeted message</p>
                <h2 id="broadcast-heading">Broadcast announcement</h2>
                <p>Send an audited push notification to selected accounts. Use expiry to describe a temporary event.</p>
            </div>
            <div class="broadcast-form">
                <label>
                    Title
                    <input id="broadcast-title" type="text" maxlength="80"
                           placeholder="Limits lifted" />
                </label>
                <label>
                    Message
                    <textarea id="broadcast-body" maxlength="240"
                              placeholder="Psssttt — limits are lifted for selected users for 6 hours."></textarea>
                </label>
                <label>
                    Account UIDs, one per line
                    <textarea id="broadcast-recipients" maxlength="18000"
                              placeholder="Paste Firebase account IDs here"></textarea>
                </label>
                <label>
                    Announcement expires
                    <input id="broadcast-expiry" type="datetime-local" />
                </label>
                <button id="send-broadcast" type="button">Preview and send</button>
            </div>
        </section>

        <div class="console-grid">
            <section class="queue" aria-labelledby="queue-heading">
                <div class="section-heading">
                    <p class="eyebrow">Incoming</p>
                    <h2 id="queue-heading">Report queue</h2>
                </div>
                <ol id="report-list"></ol>
            </section>

            <section class="review" aria-labelledby="review-heading">
                <div class="section-heading">
                    <p class="eyebrow">Evidence</p>
                    <h2 id="review-heading">Report review</h2>
                </div>
                <div id="empty-review" class="empty">Select a report to review server evidence.</div>
                <div id="report-review" hidden>
                    <dl id="report-metadata"></dl>
                    <canvas id="evidence-canvas" width="640" height="640"
                            aria-label="Server-captured reported region"></canvas>
                    <details>
                        <summary>Raw private evidence</summary>
                        <pre id="raw-evidence"></pre>
                    </details>
                    <div class="actions">
                        <label>
                            Required reason
                            <textarea id="action-reason" maxlength="500"></textarea>
                        </label>
                        <label>
                            Target account UID
                            <input id="target-account" type="text" />
                        </label>
                        <label>
                            Suspension expiry
                            <input id="suspension-expiry" type="datetime-local" />
                        </label>
                        <div class="action-buttons">
                            <button type="button" data-action="dismiss">Dismiss</button>
                            <button type="button" data-action="quarantine">Quarantine region</button>
                            <button type="button" data-action="rollback">Roll back implicated pixels</button>
                            <button type="button" data-action="warn">Warn account</button>
                            <button type="button" data-action="suspend">Suspend account</button>
                            <button type="button" data-action="ban" class="danger">Ban account</button>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script type="module" src="~/js/moderation.mjs" asp-append-version="true"></script>
</body>
</html>
