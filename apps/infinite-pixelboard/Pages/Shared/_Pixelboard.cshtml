@using Microsoft.Extensions.Options
@using PixelBoard.Configuration
@inject IOptions<AdvertisingOptions> Advertising
@{
    var advertising = Advertising.Value;
}
<div class="pixelboard-app" data-pixelboard-app>
    <a class="skip-link" href="#board-canvas">Skip to canvas</a>

    <header class="board-header">
        <a class="board-wordmark" href="/" aria-label="Collapse Technologies Infinite Pixelboard">
            <span>Collapse</span>
            <span>Technologies</span>
        </a>
        <p class="board-edition">Infinite Pixelboard <span>/ Public field 001</span></p>
        <button class="icon-button account-button" type="button" data-panel-toggle aria-expanded="false"
                aria-controls="account-panel" aria-label="Settings">
            <span>Settings</span>
            <span class="account-button__arrow" aria-hidden="true">↗</span>
        </button>
    </header>

    <main class="board-stage">
        <canvas id="board-canvas" class="board-canvas" tabindex="0"
                aria-label="Infinite collaborative pixel canvas. Drag to pan, use the mouse wheel to zoom, use arrow keys to move the keyboard cursor, Shift plus arrow keys to pan, and Enter to place.">
        </canvas>

        <section class="palette" aria-label="Pixel color">
            <span class="palette-label">Ink</span>
            <div class="swatches" role="radiogroup" aria-label="Choose a pixel color" data-palette></div>
            <span class="palette-tier" data-palette-tier>Free palette</span>
            <label class="custom-color" data-custom-color hidden>
                <span class="sr-only">Custom color</span>
                <input type="color" value="#d3523c" data-color-picker />
            </label>
        </section>

        <div class="board-readout" aria-live="polite">
            <span data-coordinate>ROW +0000 / COL +0000</span>
            <span data-zoom>100%</span>
        </div>

        <div class="zoom-controls" aria-label="Canvas controls">
            <button type="button" data-zoom-out aria-label="Zoom out">−</button>
            <button type="button" data-zoom-in aria-label="Zoom in">+</button>
            <button type="button" data-locate-open aria-label="Go to coordinates">Go</button>
        </div>

        <div class="connection-pill" data-connection role="status"
             title="Live updates. You can still paint.">
            <span aria-hidden="true"></span>
            <strong>Syncing</strong>
        </div>

        <div class="placement-status" data-placement-status role="status" aria-live="polite">
            Viewing anonymously
        </div>

        <div class="board-actions" aria-label="Board actions">
            <button type="button" data-share-position aria-label="Share this position">Share</button>
            <button type="button" data-report-open aria-label="Report current position">Report</button>
        </div>

        @if (advertising.WebEnabled && advertising.ModerationOperationsEnabled)
        {
            <aside class="board-ad" data-ad-container
                   data-ad-client="@advertising.AdSensePublisherId"
                   data-ad-slot="@advertising.AdSenseBoardSlotId"
                   aria-label="Advertisement" hidden>
                <span>Sponsored</span>
                <ins class="adsbygoogle"
                     data-ad-client="@advertising.AdSensePublisherId"
                     data-ad-slot="@advertising.AdSenseBoardSlotId"
                     data-ad-format="horizontal"
                     data-full-width-responsive="true"></ins>
                <a class="board-ad__fallback" data-ad-fallback href="#pro" hidden>
                    Pixelboard Pro / one-second paint / no ads
                </a>
            </aside>
        }
    </main>

    <dialog class="locate-dialog" data-locate-dialog aria-labelledby="locate-title">
        <form data-locate-form>
            <div class="panel-heading">
                <p class="eyebrow">Navigate</p>
                <button class="icon-button" type="button" data-locate-close aria-label="Close go to coordinates">Close</button>
            </div>
            <h2 id="locate-title">Go to<br />coordinates.</h2>
            <p class="panel-copy">
                Enter a row and column to center that pixel on the board.
            </p>
            <div class="locate-fields">
                <label class="report-field">
                    Row
                    <input type="number" step="1" inputmode="numeric" required data-locate-row />
                </label>
                <label class="report-field">
                    Column
                    <input type="number" step="1" inputmode="numeric" required data-locate-column />
                </label>
            </div>
            <div class="locate-quick-actions" aria-label="Quick positions">
                <button type="button" data-locate-origin>Origin (0,0)</button>
                <button type="button" data-locate-selected>Selected position</button>
            </div>
            <p class="auth-note" data-locate-status role="status" aria-live="polite"></p>
            <button class="report-submit" type="submit">Center board</button>
        </form>
    </dialog>

    <aside class="account-panel" id="account-panel" data-account-panel aria-hidden="true" inert>
        <div class="panel-heading">
            <p class="eyebrow">Settings</p>
            <button class="icon-button" type="button" data-panel-close aria-label="Close settings">Close</button>
        </div>
        <h2 data-account-heading>Account</h2>
        <p class="panel-copy">
            Sign in to place pixels. Pro and invite boosts speed the cooldown; they never remove it.
        </p>
        <div class="auth-actions">
            <button type="button" data-login-provider="google">
                <span aria-hidden="true">G</span> Continue with Google
            </button>
            <button type="button" data-login-provider="apple">
                <span aria-hidden="true">●</span> Continue with Apple
            </button>
            <button type="button" data-sign-out hidden>
                <span aria-hidden="true">↗</span> Sign out
            </button>
            <button type="button" data-accept-standards hidden>
                Accept community standards
            </button>
        </div>
        <p class="auth-note" data-auth-note>
            Connecting secure sign-in…
        </p>
        <details class="panel-section" data-billing-section hidden>
            <summary>Get Pro <span aria-hidden="true">+</span></summary>
            <div class="panel-section__body">
                <div class="invite-block" data-billing-block hidden>
                    <p class="panel-copy">
                        Pro is one second between pixels and unlocks the extended palette plus custom colors.
                        On the website you pay through Stripe. The iPhone app uses Apple.
                    </p>
                    <button type="button" data-billing-month>Pro monthly · $2.99</button>
                    <button type="button" data-billing-year>Pro annual · $24.99</button>
                    <button type="button" data-billing-portal hidden>Manage billing</button>
                    <p class="auth-note" data-billing-status role="status" aria-live="polite"></p>
                </div>
            </div>
        </details>
        <details class="panel-section" data-invite-section hidden>
            <summary>Invite a painter <span aria-hidden="true">+</span></summary>
            <div class="panel-section__body">
                <div class="invite-block" data-invite-block hidden>
                    <p class="panel-copy">
                        Share your code. When they sign in and accept the standards, they get
                        4 hours at a 2-second cooldown. You get 4 hours at 3 seconds. This is
                        not Pro, and it never removes the cooldown.
                    </p>
                    <p class="invite-code" data-invite-code>—</p>
                    <button type="button" data-copy-invite>Copy invite link</button>
                    <label class="report-field">
                        Have a code?
                        <input type="text" maxlength="12" autocomplete="off" spellcheck="false" data-redeem-code />
                    </label>
                    <button type="button" data-redeem-invite>Redeem invite</button>
                    <p class="auth-note" data-invite-status role="status" aria-live="polite"></p>
                </div>
            </div>
        </details>
        <details class="panel-section" data-account-section>
            <summary>Account <span aria-hidden="true">+</span></summary>
            <div class="panel-section__body">
                <dl class="account-state">
                    <div><dt>State</dt><dd data-account-state>Anonymous</dd></div>
                    <div><dt>Cooldown</dt><dd data-cooldown>—</dd></div>
                    <div><dt>Paint boost</dt><dd data-boost-state>None</dd></div>
                </dl>
            </div>
        </details>
        <details class="panel-section">
            <summary>More <span aria-hidden="true">+</span></summary>
            <div class="panel-section__body">
                <p class="panel-copy">Pixels you place are public. Anyone can overwrite them.</p>
                <p class="panel-footnote">
                    <a href="/Privacy">Privacy</a>
                    <span aria-hidden="true">·</span>
                    <a href="/Terms">Terms</a>
                </p>
            </div>
        </details>
    </aside>

    <dialog class="report-dialog" data-report-dialog aria-labelledby="report-title">
        <form data-report-form>
            <div class="panel-heading">
                <p class="eyebrow">Community safety</p>
                <button class="icon-button" type="button" data-report-close aria-label="Close report dialog">Close</button>
            </div>
            <h2 id="report-title">Report current position.</h2>
            <p class="panel-copy">
                Mark the affected area. We capture the pixels and placement history.
                You do not need a screenshot.
            </p>
            <output class="report-region" data-report-region>ROW +0000 / COL +0000 · 8 × 8</output>
            <div class="report-dimensions">
                <label>Width <input type="number" min="1" max="64" value="8" data-report-width /></label>
                <label>Height <input type="number" min="1" max="64" value="8" data-report-height /></label>
            </div>
            <label class="report-field">
                Reason
                <select required data-report-reason>
                    <option value="">Select a reason</option>
                    <option value="0">Explicit sexual content</option>
                    <option value="1">Graphic violence</option>
                    <option value="2">Hate or harassment</option>
                    <option value="3">Threat</option>
                    <option value="4">Illegal content</option>
                    <option value="5">Copyright</option>
                    <option value="6">Other</option>
                </select>
            </label>
            <label class="report-field">
                Note <span data-report-note-hint>Optional · 500 characters</span>
                <textarea maxlength="500" rows="4" data-report-note></textarea>
            </label>
            <p class="auth-note" data-report-status role="status" aria-live="polite"></p>
            <button class="report-submit" type="submit">Submit report</button>
        </form>
    </dialog>

    <div class="panel-scrim" data-panel-scrim hidden></div>
</div>
