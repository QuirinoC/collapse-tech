<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#eee8dc" />
    <meta name="description" content="Infinite Pixelboard is a shared infinite mural everyone paints together. Explore live on the web; sign in to place pixels with friends and strangers." />
    <meta property="og:title" content="Infinite Pixelboard — shared mural" />
    <meta property="og:description" content="A collaborative infinite mural. Anyone can explore live; sign in to paint. Free 5s cooldown; optional Pro." />
    <meta property="og:type" content="website" />
    <title>@ViewData["Title"] — Collapse Technologies</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PixelBoard.styles.css" asp-append-version="true" />
</head>
<body class="@ViewData["BodyClass"]">
    @RenderBody()
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
