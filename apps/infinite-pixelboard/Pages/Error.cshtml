@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<main class="error-page">
    <header class="legal-header">
        <a class="collapse-wordmark legal-wordmark" href="/">
            <span>Collapse</span>
            <span>Technologies</span>
        </a>
        <a class="legal-back" href="/">Back to board ↗</a>
    </header>
    <section class="error-card" aria-labelledby="error-title">
        <p class="eyebrow">Infinite Pixelboard / Signal lost</p>
        <h1 id="error-title">Something<br />went quiet.</h1>
        <p class="error-copy">The board could not complete that request. Return to the canvas and try again.</p>
        @if (Model.ShowRequestId)
        {
            <p class="error-request">
                <span>Request ID</span>
                <code>@Model.RequestId</code>
            </p>
        }
        <a class="error-action" href="/">Return to board</a>
    </section>
</main>
